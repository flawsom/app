# ─── UNIFY .gitignore ────────────────────────────────────────────────
# See https://help.github.com/articles/ignoring-files/ for more details.

# IDE and editors
.idea/
.vscode/
*.swp
*~

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
build/
dist/
dist

# ── Environment & credentials (NEVER commit real values) ─────────────
.env
.env.*
!.env.example
!backend/.env.example
!frontend/.env.example
*.env
credentials.json
*.pem
*.key
*.cert
.credentials
*token.json*
*credentials.json*
service-account*.json

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb
*.log

# System files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
.pytest_cache/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment / platform
.vercel
.render

# Data and databases
agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Test credentials — local only
memory/test_credentials.md

# Mobile development
android-sdk/

# Platform-specific native deps that are huge
frontend/node_modules/@next/swc-linux-x64-musl/next-swc.linux-x64-musl.node
frontend/node_modules/@next/swc-linux-x64-gnu/next-swc.linux-x64-gnu.node

# Sentry source maps (uploaded to Sentry, not committed)
.sentryclirc
-e 
# Environment and credential files
.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials
-e 
# Environment and credential files
.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials
